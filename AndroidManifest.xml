<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.edualexxis.batterybuddy" android:versionCode="2" android:versionName="1.1">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34"/>
  <application android:label="BatteryBuddy" android:icon="@drawable/ic_launcher">
    <meta-data android:name="xposedmodule" android:value="true"/>
    <meta-data android:name="xposeddescription" android:value="Customize the status bar"/>
    <meta-data android:name="xposedminversion" android:value="82"/>
    <meta-data android:name="xposedscope" android:resource="@array/scope"/>
    <activity android:name=".SettingsActivity" android:exported="true" android:label="BatteryBuddy"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <provider android:name=".PrefsProvider" android:authorities="io.github.edualexxis.batterybuddy.prefs"
        android:exported="true"/>
  </application>
</manifest>
